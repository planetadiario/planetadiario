{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planetadiario",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/n/*", "/c/*", "/sitemap.xml", "/sitemap-noticias.xml", "/ads.txt"]
  },
  "routes": [
    // rotas sobre os registros DNS já existentes (proxied) da zona
    { "pattern": "planetadiario.online/*", "zone_name": "planetadiario.online" },
    { "pattern": "www.planetadiario.online/*", "zone_name": "planetadiario.online" }
  ],
  // Coleta a cada 5 min; métricas a cada 30 min; Instagram pendente a cada 10 min
  "triggers": { "crons": ["*/5 * * * *", "2,32 * * * *", "7-57/10 * * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://ilnmrhgnaojgykkresfi.supabase.co",
    "SITE_URL": "https://planetadiario.online",
    "GITHUB_REPO": "planetadiario/planetadiario",
    "FB_GRAPH_VERSION": "v23.0",
    // IA: "nvidia/nemotron-3.5-super-vl-120b-a12b" (NVIDIA, grátis, vê imagens) ou "claude-opus-5-5" (Anthropic)
    // o Kimi K3 foi desativado pela NVIDIA em out/2026; há lista de reserva em worker/ia.ts
    "IA_MODELO": "nvidia/nemotron-3.5-super-vl-120b-a12b"
  }
  // Segredos (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY,
  // LYTEX_CLIENT_ID, LYTEX_CLIENT_SECRET, LYTEX_CALLBACK_SECRET, NVIDIA_API_KEY, GITHUB_TOKEN, FB_PAGE_ID, FB_PAGE_TOKEN, YOUTUBE_API_KEY, INTERNAL_SECRET
}
