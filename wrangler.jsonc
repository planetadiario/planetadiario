{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planetadiario",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "planetadiario.online", "custom_domain": true },
    { "pattern": "www.planetadiario.online", "custom_domain": true }
  ],
  // Coleta de tendências a cada 10 minutos
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://ilnmrhgnaojgykkresfi.supabase.co",
    "GITHUB_REPO": "planetadiario/planetadiario",
    "FB_GRAPH_VERSION": "v23.0",
    "CLAUDE_MODEL": "claude-opus-5-5"
  }
  // Segredos (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY,
  // GITHUB_TOKEN, FB_PAGE_ID, FB_PAGE_TOKEN, YOUTUBE_API_KEY, INTERNAL_SECRET
}
